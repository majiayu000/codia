# Server-side shared secret for /api/** POST routes (required in production).
# Requests must send: Authorization: Bearer <CODIA_API_SECRET>
CODIA_API_SECRET=change-me-to-a-long-random-secret

# Same value for same-origin demo clients (browser bundle).
# Keep identical to CODIA_API_SECRET for local demos.
NEXT_PUBLIC_CODIA_API_SECRET=change-me-to-a-long-random-secret

# Provider keys (server only — never expose to the client)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
KOKORO_API_URL=http://localhost:8080
