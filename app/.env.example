# Server-side shared secret for /api/** POST routes (required).
# External/script callers: Authorization: Bearer <CODIA_API_SECRET>
# Browser clients: GET /api/auth/session sets an httpOnly cookie (no public secret).
CODIA_API_SECRET=change-me-to-a-long-random-secret

# Set to true/1 only behind a trusted reverse proxy that strips client
# X-Forwarded-For / X-Real-IP / CF-Connecting-IP before forwarding.
# When unset, rate limiting uses request.ip (if available) or a single "direct" bucket.
# CODIA_TRUST_PROXY=true

# Provider keys (server only — never expose to the client)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
KOKORO_API_URL=http://localhost:8080
